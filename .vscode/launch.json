{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: uvicorn",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "graphrag_exposure.api.main:app",
                "--reload"
            ],
            "justMyCode": true
        },
        {
            "name": "Pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-v"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
